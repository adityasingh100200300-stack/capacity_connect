# Capacity Connect - Environment Variables
# Copy this file to .env and fill in your values.
# .env itself should be listed in .gitignore (never commit real secrets).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set USE_POSTGRES=true to switch from SQLite (default) to PostgreSQL.
# If USE_POSTGRES is not set but DB_NAME is, PostgreSQL is also activated.
USE_POSTGRES=true

# PostgreSQL connection details -- required when USE_POSTGRES=true
DB_NAME=capacity_connect
DB_USER=capacity_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
